[Unit]
Description=Bedtime Companion bedroom node
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=bedtimecompanion
Group=bedtimecompanion
WorkingDirectory=/home/bedtimecompanion/bedtime-companion
ExecStart=/usr/bin/node --env-file=.env --import tsx apps/pi-client/src/simulator.ts
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
