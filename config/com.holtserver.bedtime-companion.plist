<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.holtserver.bedtime-companion</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/holtserver/Library/Application Support/Bedtime Companion/server/server.js</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/holtserver/Library/Application Support/Bedtime Companion/server</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/holtserver/Library/Application Support/Bedtime Companion/logs/mac-server.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/holtserver/Library/Application Support/Bedtime Companion/logs/mac-server.error.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>NODE_ENV</key><string>production</string>
    <key>HOSTNAME</key><string>0.0.0.0</string>
    <key>PORT</key><string>3000</string>
  </dict>
</dict>
</plist>
